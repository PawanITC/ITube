# Copy to backend/.env (git-ignored) for local development. Never commit real values.
# Use a Stripe *sandbox* key. Prefer a restricted key (rk_test_...) over sk_test_...
STRIPE_SECRET_KEY=rk_test_replace_me
# Printed by `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FRONTEND_BASE_URL=http://localhost:3000
# Platform commission in basis points (100 = 1%) - business decision
PLATFORM_FEE_BPS=0
# 32+ random bytes, base64. e.g. openssl rand -base64 32
PLAYBACK_SIGNING_KEY=
# Set to false in production to hide Swagger UI and /v3/api-docs
API_DOCS_ENABLED=true
