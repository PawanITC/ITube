mvnw text eol=lf
*.properties text eol=lf
*.cmd text eol=crlf

# PowerShell scripts keep CRLF line endings, like the .cmd files
*.ps1 text eol=crlf

# Files used inside Linux containers / CI keep LF line endings on every OS
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
