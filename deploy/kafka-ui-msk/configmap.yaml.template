apiVersion: v1
kind: ConfigMap
metadata:
  name: kafka-ui-msk-config
  namespace: itube
  labels:
    app.kubernetes.io/name: kafka-ui-msk
    app.kubernetes.io/part-of: itube
data:
  # render.ps1 supplies the real private IAM bootstrap endpoints from Terraform's output.
  bootstrap-servers: __MSK_BOOTSTRAP_SERVERS__
  application-msk.yaml: |
    kafka:
      clusters:
        - name: itube-msk
          bootstrapServers: ${MSK_BOOTSTRAP_SERVERS}
          readOnly: true
          disableLogDirsCollection: true
          properties:
            security.protocol: SASL_SSL
            sasl.mechanism: AWS_MSK_IAM
            sasl.jaas.config: 'software.amazon.msk.auth.iam.IAMLoginModule required;'
            sasl.client.callback.handler.class: software.amazon.msk.auth.iam.IAMClientCallbackHandler
            ssl.endpoint.identification.algorithm: https
            reconnect.backoff.ms: 1000
            reconnect.backoff.max.ms: 10000
          consumerProperties:
            # Matches the dedicated UI role's kafka-ui-* group permission; never use an application group.
            group.id: kafka-ui-viewer
            enable.auto.commit: false
    dynamic:
      config:
        enabled: false
    auth:
      # Private ClusterIP only: access is through authenticated kubectl port-forward, not public ingress.
      type: DISABLED
    management:
      endpoint:
        health:
          probes:
            enabled: true
    logging:
      level:
        io.kafbat.ui: INFO
